# Body Expression Bridge Configuration
# Copy to .env and fill in your values

# Event endpoint URL (reflexd /events endpoint)
EVENTS_ENDPOINT_URL=http://localhost:8770/events

# HTTP timeout for event POST requests (seconds)
EVENTS_TIMEOUT_SECONDS=1.0

# Maximum pending events in queue before dropping oldest
EVENTS_MAX_PENDING=256

# Platforms to skip (comma-separated, case-insensitive)
EVENTS_SKIP_PLATFORMS=local,desktop,cli

# Circuit breaker: number of failures before opening
EVENTS_BREAKER_THRESHOLD=5

# Circuit breaker: cooldown seconds before half-open probe
EVENTS_BREAKER_COOLDOWN=10