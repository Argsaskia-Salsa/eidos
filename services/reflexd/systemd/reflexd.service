[Unit]
Description=Eidos Reflexd Service
After=network.target eidos-gateway.service
Wants=eidos-gateway.service

[Service]
Type=simple
WorkingDirectory=~/projects/eidos/services/reflexd
EnvironmentFile=~/projects/eidos/services/reflexd/.env
ExecStart=~/projects/eidos/services/reflexd/.venv/bin/python -m reflexd.main
Restart=always
RestartSec=5

[Install]
WantedBy=default.target