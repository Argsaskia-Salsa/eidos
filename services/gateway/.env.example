# Gateway Configuration for stackchan-mcp
# Copy to .env and fill in your values

# REQUIRED: Bearer token shared with ESP32 firmware
STACKCHAN_TOKEN=your-token-here

# Network (defaults shown)
HOST=0.0.0.0
WS_PORT=8765
CAPTURE_PORT=8766
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8767
MCP_HTTP_ALLOWED_HOSTS=

# Optional: Vision/Capture (for photo uploads from ESP32)
# VISION_URL=https://your-tailscale-funnel.ts.net/capture
# VISION_HOST=192.168.x.x
# VISION_TOKEN=separate-token-if-needed

# Optional: Audio hook for device-driven listen capture
# STACKCHAN_AUDIO_HOOK_URL=https://your-endpoint/hook
# STACKCHAN_AUDIO_HOOK_TOKEN=defaults-to-STACKCHAN_TOKEN

# Optional: Disable mDNS advertisement
# NO_MDNS=false

# Working directory (defaults to project root)
# WORKING_DIR=/home/erika/projects/eidos/services/gateway